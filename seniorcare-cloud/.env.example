# ============================================================
# ElderHarmony – Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── AWS / Bedrock ────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Railtracks (GPT-OSS LLM) ────────────────
OPENAI_API_KEY=test

# ── Twilio (voice calls + SMS) ──────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Phone numbers ───────────────────────────
# Used as fallback when health payload doesn't include contact numbers
SENIOR_PHONE_NUMBER=+1xxxxxxxxxx
FAMILY_PHONE_NUMBER=+1xxxxxxxxxx

# ── Pharmacy API ────────────────────────────
PHARMACY_API_URL=https://pharmacy.example.com/api/v1
PHARMACY_API_KEY=
DEFAULT_REFILL_QTY=30

# ── Lambda ARNs (only needed for Lambda-based deployment) ──
VITAL_SYNC_AGENT_ARN=
MEDICINE_AGENT_ARN=
EMO_CARE_AGENT_ARN=
CALLING_AGENT_ARN=
HEALTH_RECORDS_AGENT_ARN=
